# Backend
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost

# Postgres — sin valor por defecto a propósito, docker-compose no arranca sin esto.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=coaching
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coaching

# Redis (opcional: si se deja vacío, redis queda sin autenticación — sólo aceptable
# porque hoy no se expone fuera de la red interna de docker en producción)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (JWT) — la app NO arranca si estos quedan con el valor de ejemplo o son cortos.
# Genera uno real por variable con: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12

# Bootstrap: creates the first Coach account on first boot if none exists yet
SEED_COACH_EMAIL=coach@example.com
SEED_COACH_PASSWORD=change-me-please

# SMTP (Gmail): used to email temporary passwords when creating/resetting accounts.
# SMTP_PASS is a Gmail "App Password" (myaccount.google.com/apppasswords), not the normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
